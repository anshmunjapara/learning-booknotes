<%- include('partials/header.ejs'); -%>

    <body>

        <div class="container mb-3">
            <header class="border-bottom lh-1 py-3">
                <div class="row flex-nowrap justify-content-between align-items-center">
                    <div class="col-4 pt-1"> <a class="link-secondary" href="#">Subscribe</a> </div>
                    <div class="col-4 text-center"> <a class="blog-header-logo text-body-emphasis text-decoration-none"
                            href="#">Large</a> </div>
                    <div class="col-4 d-flex justify-content-end align-items-center"> <a class="link-secondary" href="#"
                            aria-label="Search"> <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2" class="mx-3" role="img" viewBox="0 0 24 24">
                                <title>Search</title>
                                <circle cx="10.5" cy="10.5" r="7.5"></circle>
                                <path d="M21 21l-5.2-5.2"></path>
                            </svg> </a> <a class="btn btn-sm btn-outline-secondary" href="#">Sign up</a> </div>
                </div>
            </header>
        </div>
        <div class="container px-5">
            <!-- book cover and details -->
            <div class="row g-5 align-items-start">
                <!-- image -->
                <div class="col-md-4 text-center">
                    <img src="https://covers.openlibrary.org/b/isbn/0385472579-L.jpg" class="img-fluid rounded"
                        alt="Book Cover Placeholder">
                </div>
                <!-- book details -->
                <div class="col-md-8">
                    <div class="row align-items-center">
                        <div class="col">
                            <h2 class="fw-bold">
                                <%= book.title %>
                            </h2>
                        </div>
                        <!-- edit button -->
                        <div class="col-auto">
                            <button type="button" class="btn btn-bd-primary">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                        </div>
                    </div>
                    <p class="text-body-secondary mb-1">ISBN: <%= book.isbn %>
                    </p>
                    <p class="text-body-secondary mb-3">Read: <%= book.date %>
                    </p>

                    <div>
                        <span class="badge bg-primary fs-6">
                            Rating: <%= book.rating %>/10
                        </span>
                    </div>

                    <p class="mt-3">
                        <%= book.des %>
                    </p>
                </div>
            </div>
        </div>
        <!-- hr -->
        <div class="container">
            <hr>
        </div>
        <div class="container">
            <h4 class="fw-bold mb-3">My Notes</h4>

            <div id="addNotePanel" class="add-note-panel">
                <div class="panel-content py-3">
                    <textarea id="newNoteText" class="form-control mb-3" rows="4"
                        placeholder="Write your note..."></textarea>
                    <div class="d-flex justify-content-end gap-2">
                        <button id="cancelNoteBtn" class="btn btn-secondary">Cancel</button>
                        <button id="submitNoteBtn" class="btn btn-primary">Add New</button>
                    </div>
                </div>
            </div>

            <% notes.forEach(note=> { %>
                <div class="card mb-3 note-card" data-id="<%= note.id %>">
                    <div class="card-body">

                        <h6 class="card-subtitle mb-2 text-body-secondary note-time">
                            <%= note.datetime %>
                        </h6>

                        <p class="card-text note-content">
                            <%= note.content %>
                        </p>

                        <textarea class="form-control note-textarea mb-3 d-none"><%= note.content %></textarea>

                        <div class="buttons-view d-flex gap-2 justify-content-end">
                            <a href="#" class="btn btn-sm btn-primary btn-edit"><i class="bi bi-pencil-square"></i></a>
                            <a href="#" class="btn btn-sm btn-outline-danger btn-delete"><i class="bi bi-trash"></i></a>
                        </div>

                        <div class="buttons-edit d-flex gap-2 justify-content-end d-none">
                            <a href="#" class="btn btn-sm btn-success btn-submit">Submit</a>
                            <a href="#" class="btn btn-sm btn-secondary btn-cancel">Cancel</a>
                        </div>

                    </div>
                </div>
                <% }); %>
        </div>

        <script src="/js/bootstrap.bundle.min.js"></script>
        <script src="/js/book.js"></script>
    </body>

    <%- include('partials/footer.ejs'); -%>